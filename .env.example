# ── Database ──────────────────────────────────────────────────────────────────
# asyncpg URL used by backend and worker services
DATABASE_URL=postgresql+asyncpg://rosetta:rosetta@localhost:5432/rosetta

# ── Execution backend ─────────────────────────────────────────────────────────
# false = LocalBackend (pandas + PostgreSQL)
# true  = DatabricksBackend (PySpark) — Phase 4, not yet implemented.
#         CLOUD=true is not currently supported: the worker process will
#         refuse to start (fails fast at boot rather than failing each job).
CLOUD=false

# ── LLM ───────────────────────────────────────────────────────────────────────
# Provider and model resolved by Pydantic AI from this string
# Examples: anthropic:claude-sonnet-4-6 | openai:gpt-4o
LLM_MODEL=anthropic:claude-sonnet-4-6

# Provider API keys — only the key matching LLM_MODEL is required
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL the browser uses to reach the backend API
VITE_API_URL=http://localhost:8000

# ── TensorZero (optional, off by default) ─────────────────────────────────────
# NOTE: upstream is archived/unmaintained — the company shut down 2026-06-12.
# See issue #143 before enabling this for anything long-term.
# Uncomment below to route through the gateway instead of calling providers directly.
# TENSORZERO_GATEWAY_URL=http://tensorzero:3000/openai/v1
# Azure credentials for the gateway itself (config/tensorzero.toml), not the worker —
# only needed if the line above is uncommented.
# AZURE_AI_FOUNDRY_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
# AZURE_AI_FOUNDRY_API_KEY=your-key-here
# Only needed if routing to claude-opus-4-5 — gpt-5.4 only needs the two above.
# AZURE_ANTHROPIC_ENDPOINT=https://your-resource.cognitiveservices.azure.com/anthropic/v1/

# ── Azure OpenAI (direct, no TensorZero) ──────────────────────────────────────
# Used by the worker itself as a fallback when TENSORZERO_GATEWAY_URL is unset.
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=your-key-here

# ── Worker ────────────────────────────────────────────────────────────────────
POLL_INTERVAL_SECONDS=5
